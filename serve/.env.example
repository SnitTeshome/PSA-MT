# Copy to .env and fill in if you need to override a default. .env is
# gitignored - never commit a real token.

# Not needed at all if both checkpoints load from local disk (the default -
# see DEPLOYMENT_DIR below). Only needed once you switch a system to load from
# a private Hugging Face repo instead. A READ-scoped token is all this service
# ever needs - it never uploads anything. Generate one at
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where this project's deployment-ready checkpoints live. Defaults to
# ../deployment relative to this file, i.e. Final_Training/deployment - change
# this only if the checkpoints are somewhere else on this machine.
DEPLOYMENT_DIR=

# Per-system source. Defaults to DEPLOYMENT_DIR/nllb/<run_id> (local disk, no
# token needed). Set to a Hub repo id (e.g. "username/nllb-ekegusii-ablation")
# plus the matching _SUBFOLDER to load from the Hub instead -
# 07_publish_to_hub.ipynb pushes several checkpoints into one repo as
# subfolders, so both repo id and subfolder are needed together for a Hub
# source; neither is used for a local path.
HF_EKEGUSII=
HF_EKEGUSII_SUBFOLDER=nllb_mixed_lora_only
HF_OTHER_LANGS=
HF_OTHER_LANGS_SUBFOLDER=nllb_combined_other_langs

# How many models stay in memory at once. 2 keeps both instant; 1 trades an
# occasional reload pause for lower idle memory.
MAX_RESIDENT=2
# Load both models at startup rather than on first request, so the first
# visitor does not wait for a cold load.
PRELOAD=1

# Beam width - matches what the training notebooks evaluate with, so a number
# in a results table and a string on screen come from the same settings.
BEAMS=4
MAX_NEW_TOKENS=128

# Which systems to serve: "ekegusii", "other_langs", or both (default).
ENABLED_SYSTEMS=ekegusii,other_langs

# Where corrections go: a Hugging Face DATASET repo you own. Leave empty and
# feedback is written to this process's local disk only, lost on restart.
FEEDBACK_REPO=

# Set to 1 to run the UI with no weights at all, for front-end work.
MOCK_MODE=0
